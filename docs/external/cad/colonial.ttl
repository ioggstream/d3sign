cad:0_45095151035943726
    a cad:Note;
    rdfs:comment
        """On may 7th 2021 the Colonial Pipeline Company (CPC) 
learned they were victims of a ransomware cyber attack.


In response CPC "proactively took certain systems offline"
halting pipeline activity.""";
    rdfs:label "Pipeline Shutdown ".
cad:0_4721990413299503 a d3f:OTActuator; rdfs:label "OT Actuator".

cad:0_5094563823244651 a d3f:Network; rdfs:label "IT Network".

