# title: Measures D3FEND offers for the selected node
# about: Defensive techniques that act on the selected node's class or any of its superclasses. Select a node in the graph first.
# needs: d3fend
# scope: selection

# We walk ?class' superclasses, so e.g.,
# d3f:Password also collects everything D3FEND aims at d3f:Credential and
# d3f:DigitalArtifact.
SELECT DISTINCT ?measure ?measureLabel ?verb ?appliesTo ?d3fendId WHERE {
  { SELECT DISTINCT ?g WHERE { GRAPH ?g {} FILTER(!STRSTARTS(STR(?g), STR(K:))) } }
  GRAPH ?g { ?this a ?class }

  GRAPH K:d3fend {
    ?class rdfs:subClassOf* ?appliesTo .
    ?measure ?verb ?appliesTo .
    ?measure rdfs:subClassOf* d3f:DefensiveTechnique ;
             rdfs:label ?measureLabel ;
             d3f:d3fend-id ?d3fendId .
    ?verb rdfs:subPropertyOf* d3f:d3fend-object-property .
  }
}
ORDER BY ?measureLabel
