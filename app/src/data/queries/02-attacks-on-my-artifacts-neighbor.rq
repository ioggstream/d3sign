# title: All attacks, via neighbors
# about: Offensive techniques via neighbors.
# needs: d3fend

SELECT DISTINCT
  ?artifact ?label ?attack ?attackLabel ?attackId ?neighbor
WHERE {
  { SELECT DISTINCT ?g WHERE { GRAPH ?g {} FILTER(!STRSTARTS(STR(?g), STR(K:))) } }
  GRAPH ?g {
    ?artifact a ?class .
    OPTIONAL { ?artifact rdfs:label ?label }
  }

  GRAPH K:d3fend {
    ?neighbor rdfs:subClassOf* d3f:DigitalArtifact .
    { ?neighbor ?rel1 ?class .
      ?rel1 rdfs:subPropertyOf* d3f:d3fend-object-property .
    }
    UNION
    { ?class ?rel2 ?neighbor .
    ?rel2 rdfs:subPropertyOf* d3f:d3fend-object-property .
    }
    ?attack ?verb ?neighbor .
    ?attack d3f:attack-id ?attackId ;
            rdfs:subClassOf* d3f:OffensiveTechnique ;
            rdfs:label ?attackLabel .
    ?verb rdfs:subPropertyOf* d3f:d3fend-object-property .
  }
}
ORDER BY ?attackId ?label
