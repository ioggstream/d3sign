# title: Artifacts neighbours (CONSTRUCT)
# about: Neighbours of a selected artifact, as the actual D3FEND relations between its class and the neighbouring artifact classes. Add the result as a graph to see it drawn.
# needs: d3fend
# scope: selection

CONSTRUCT {
  ?neighbor ?rel1 ?class .
  ?class    ?rel2 ?neighbor .
}
WHERE {
  { SELECT DISTINCT ?g WHERE { GRAPH ?g {} FILTER(!STRSTARTS(STR(?g), STR(K:))) } }
  GRAPH ?g { ?this a ?class . }

  {
    ?neighbor rdfs:subClassOf* d3f:DigitalArtifact .
    { ?neighbor ?rel1 ?class .
      ?rel1 rdfs:subPropertyOf* d3f:d3fend-object-property .
    }
    UNION
    { ?class ?rel2 ?neighbor .
    ?rel2 rdfs:subPropertyOf* d3f:d3fend-object-property .
    }
  }
}
