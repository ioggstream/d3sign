# title: Coverage by tactic
# about: Finding undocumented/unused tactics.
# needs: d3fend

# Every tactic is listed, then left-joined against the document, so a tactic you
# have not addressed appears with a count of 0.
SELECT
  ?tactic ?tacticLabel
  (COUNT(DISTINCT ?measure) AS ?measures)
WHERE {
  GRAPH K:d3fend {
    ?tactic rdfs:subClassOf d3f:DefensiveTactic .
  }
  OPTIONAL {
    { SELECT DISTINCT ?g WHERE { GRAPH ?g {} FILTER(!STRSTARTS(STR(?g), STR(K:))) } }
    GRAPH ?g { ?measure a ?measureClass }
    GRAPH K:d3fend {
      ?generalMeasure rdfs:subClassOf+ d3f:DefensiveTechnique .
      ?measureClass rdfs:subClassOf* ?generalMeasure .
      ?generalMeasure d3f:enables ?tactic .
      ?generalMeasure d3f:enables ?tactic .

    }
  }
}
GROUP BY ?tactic ?tacticLabel
ORDER BY ?measures ?tacticLabel
