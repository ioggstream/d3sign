# title: Everything the document says about the selected node
# about: Every triple with the selected node on either side, and which graph asserts it.
# scope: selection

SELECT ?graph ?subject ?predicate ?object WHERE {
  GRAPH ?graph {
    { ?this ?predicate ?object . BIND(?this AS ?subject) }
    UNION
    { ?subject ?predicate ?this . BIND(?this AS ?object) }
  }
}
ORDER BY ?graph ?predicate
