{
  "name": "d3sign",
  "displayName": "D3sign — D3FEND graph for mermaid",
  "description": "Draws the D3FEND graph of the mermaid diagrams in a markdown file, and shows its RDF as TriG.",
  "version": "0.1.0",
  "publisher": "d3sign",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "d3sign.openGraph",
        "title": "Open D3FEND graph",
        "category": "D3sign"
      },
      {
        "command": "d3sign.openTrig",
        "title": "Open RDF (TriG)",
        "category": "D3sign"
      }
    ],
    "keybindings": [
      {
        "command": "d3sign.openGraph",
        "key": "alt+g",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "d3sign.openTrig",
        "key": "alt+r",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "languages": [
      {
        "id": "trig",
        "aliases": [
          "TriG"
        ],
        "extensions": [
          ".trig"
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository -o d3sign.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.5"
  }
}
